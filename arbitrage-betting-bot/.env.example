# Get a free key at https://the-odds-api.com/
ODDS_API_KEY=

# Comma-separated sport keys, or "upcoming" for the next games across all sports.
SPORTS=upcoming

# Comma-separated region codes for bookmakers: us,uk,eu,au
REGIONS=us,uk,eu,au

# Comma-separated market keys: h2h,spreads,totals
MARKETS=h2h

# Minimum guaranteed profit (as a percent of total stake) to report an opportunity.
MIN_PROFIT_PERCENT=1.0

# Seconds between scans when running in loop mode.
POLL_INTERVAL_SECONDS=300

# Hypothetical total stake used to compute the per-outcome stake split.
TOTAL_STAKE=100

# Where opportunities are appended as JSON lines.
LOG_FILE=arbitrage_log.jsonl
